# 将此文件复制为 .env，填入真实密钥
# cp .env.example .env
#
# .env 已加入 .gitignore，不会被提交到仓库

# ---- API Keys（四选一，或用通用字段）----

# OpenAI
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 智谱 GLM
# ZHIPU_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.xxxxxxxxxxxxxxxx

# 阿里通义千问（对话模型）
# TONGYI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 阿里 DashScope（Embedding，RAG 使用）
# DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# DeepSeek
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 通用覆盖（优先级最高，可覆盖上面任意一个）
# LLM_API_KEY=

# ---- 可选覆盖（不填则使用 config.yaml 的值）----

# 覆盖模型名
# LLM_MODEL=gpt-4o

# 覆盖自定义端点（如代理或兼容接口）
# LLM_BASE_URL=https://your-proxy.example.com/v1

# 覆盖 Provider
# LLM_PROVIDER=openai

# 覆盖日志级别
# LOG_LEVEL=debug

# ---- 服务配置（Lesson 08-09 新增）----

# Qdrant 向量数据库地址
# 本地开发：http://localhost:6333（默认，可不填）
# Docker Compose：由 docker-compose.yml 自动注入 http://qdrant:6333
# QDRANT_URL=http://localhost:6333

# JWT 签名密钥（至少 32 字节随机字符串）
# 未设置时身份认证禁用（开发模式）
# 生成命令：openssl rand -base64 32
# JWT_SECRET=your-32-bytes-or-longer-random-secret

# 服务 API Key（调用 POST /auth/token 换取 JWT 用）
# SERVICE_API_KEY=sk-your-service-api-key
